# Postgres connection string used by Prisma (Migrate + Client)
DATABASE_URL=

# Supabase project settings — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — used later for AI features (TZ generation, scoring, protocols)
ANTHROPIC_API_KEY=
